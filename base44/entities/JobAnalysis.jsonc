{
  "name": "JobAnalysis",
  "type": "object",
  "properties": {
    "job_text": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "matched_skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "gap_skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "match_percentage": {
      "type": "integer",
      "default": 0
    },
    "date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "job_text"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}