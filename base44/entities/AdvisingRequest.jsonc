{
  "name": "AdvisingRequest",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string"
    },
    "faculty_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "topic": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "student_id"
  ]
}